#!/usr/bin/env python3
"""
eolo - Interfaz unificada de comandos para desarrollo, compilación y respaldos de EOLO.
"""

import os
import sys
import subprocess
from pathlib import Path

ROOT_DIR = Path(__file__).resolve().parent
SCRIPTS_DIR = ROOT_DIR / "scripts"
BACKUP_SCRIPT = SCRIPTS_DIR / "firmware_backup.py"
DEMO_SCRIPT = SCRIPTS_DIR / "demo.py"
MIRROR_SCRIPT = SCRIPTS_DIR / "eolo_mirror.py"
SD_BACKUP_SCRIPT = SCRIPTS_DIR / "sd_backup.py"
MIRROR_VENV = ROOT_DIR / ".pio" / "mirror-venv"
PLATFORMIO_PYTHON = Path.home() / ".platformio" / "penv" / "bin" / "python"


def get_python_runner():
    """Retorna el intérprete con pyserial disponible."""
    if PLATFORMIO_PYTHON.exists():
        return str(PLATFORMIO_PYTHON)
    return sys.executable


def run_sd_backup(args):
    """Ejecuta el script de respaldo y extracción de la tarjeta SD."""
    python = get_python_runner()
    return subprocess.call([python, str(SD_BACKUP_SCRIPT), *args])


def run_mirror(args):
    """Abre el espejo de pantalla; crea un venv con pyserial/pygame la primera vez."""
    python = MIRROR_VENV / "bin" / "python"
    if not python.exists():
        print("Preparando entorno del visor (pyserial, pygame)...")
        subprocess.check_call([sys.executable, "-m", "venv", str(MIRROR_VENV)])
        subprocess.check_call([str(python), "-m", "pip", "install", "-q", "pyserial", "pygame"])
    return subprocess.call([str(python), str(MIRROR_SCRIPT), *args])


def print_help():
    print("""
Uso: ./eolo <comando> [argumentos]

Comandos de Versiones y Respaldos:
  ./eolo tag [nombre]                 Consultar o fijar el nombre de versión actual
  ./eolo untag                        Limpiar el nombre de versión actual activo
  ./eolo name-last <nombre>           Renombrar/etiquetar el último respaldo probado
  ./eolo backups                      Listar todos los respaldos por dispositivo y demo
  ./eolo snapshot <target> -n <nom>   Crear una versión formal de entrega con notas
  ./eolo prune [--keep N]             Recortar históricos comprimidos (máximo 9 por target)

Comandos de Compilación y Flasheo:
  ./eolo build <target> [--tag tag]   Compilar dispositivo (ej. express, dron, standard)
  ./eolo flash <target> [--port port] Flashear último respaldo de un dispositivo
  ./eolo demo <subcomando> [...]      Gestión de demos (list, build, upload, monitor)

Depuración:
  ./eolo mirror [--port p] [--zoom n] Ver la pantalla del EOLO en una ventana del PC (por USB)
  ./eolo sd-backup [--port p] [--out d] Extraer todos los archivos de la SD del EOLO conectado

Ejemplos:
  ./eolo tag "calibracion_afm07"
  ./eolo build express
  ./eolo name-last "version_feria_ok"
  ./eolo backups
  ./eolo demo build AFM07 dron_legacy
  ./eolo flash express /dev/ttyUSB0
""")


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        print_help()
        return 0

    command = sys.argv[1]
    args = sys.argv[2:]

    if command == "mirror":
        return run_mirror(args)

    if command in ("sd-backup", "sd_backup", "data-backup", "sd"):
        return run_sd_backup(args)

    # Si es comando demo -> redirigir a demo.py
    if command == "demo":
        if not args:
            return subprocess.call([sys.executable, str(DEMO_SCRIPT), "--help"])
        return subprocess.call([sys.executable, str(DEMO_SCRIPT), *args])

    # Redirigir a firmware_backup.py
    return subprocess.call([sys.executable, str(BACKUP_SCRIPT), command, *args])


if __name__ == "__main__":
    sys.exit(main())
